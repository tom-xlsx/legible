{
  "name": "Bartholomew",
  "type": "svg-rig",
  "format": 1,
  "asset": "moth.svg",
  "viewBox": [0, 0, 64, 64],
  "size": 26,
  "anchors": {
    "feet": [32, 60],
    "centre": [32, 36],
    "eyeLeft": [29, 15],
    "eyeRight": [35, 15],
    "book": [32, 27]
  },
  "parts": {
    "antenna-left":  { "pivot": [29.5, 12] },
    "antenna-right": { "pivot": [34.5, 12] },
    "arm-wave":      { "pivot": [37, 24], "hidden": true },
    "tail":          { "pivot": [32, 53] },
    "wing-left":     { "pivot": [32, 23] },
    "wing-right":    { "pivot": [32, 23] },
    "thorax":        { "pivot": [32, 22] },
    "head":          { "pivot": [32, 20] },
    "eyes":          { "pivot": [32, 15] },
    "half-lids":     { "pivot": [32, 15], "hidden": true },
    "lids":          { "pivot": [32, 15], "hidden": true },
    "glasses":       { "pivot": [32, 15] },
    "magnifier":     { "pivot": [40.5, 12], "hidden": true },
    "book-open":     { "pivot": [32, 27], "hidden": true },
    "page-flip":     { "pivot": [32, 27], "hidden": true },
    "book-closed":   { "pivot": [32, 27], "hidden": true }
  },
  "headGroup": ["head", "eyes", "half-lids", "lids", "glasses"],
  "pupils": ["pupil-left", "pupil-right"],
  "pupilRange": 1.2,
  "variants": {
    "glasses-large": { "glasses": { "scale": 1.45 } },
    "eyes-drowsy":   { "half-lids": { "visible": true } },
    "body-faint":    { "head": { "opacity": 0.28 }, "thorax": { "opacity": 0.28 }, "tail": { "opacity": 0.28 },
                       "wing-left": { "opacity": 0.22 }, "wing-right": { "opacity": 0.22 },
                       "antenna-left": { "opacity": 0.28 }, "antenna-right": { "opacity": 0.28 } }
  },
  "poses": {
    "perch-idle":    { "book-closed": { "visible": true } },
    "perch-reading": { "book-open": { "visible": true } },
    "page-turn":     { "book-open": { "visible": true }, "page-flip": { "visible": true }, "head": { "rotate": 3 } },
    "doze":          { "book-closed": { "visible": true }, "eyes": { "visible": false }, "lids": { "visible": true },
                       "antenna-left": { "rotate": -35 }, "antenna-right": { "rotate": 35 }, "head": { "rotate": 6, "translate": [0, 1] } },
    "yawn":          { "book-closed": { "visible": true }, "eyes": { "visible": false }, "lids": { "visible": true },
                       "antenna-left": { "rotate": -20 }, "antenna-right": { "rotate": 20 }, "head": { "rotate": -10, "translate": [0, -1] },
                       "wing-left": { "rotate": 8 }, "wing-right": { "rotate": -8 } },
    "wake":          { "book-closed": { "visible": true }, "eyes": { "scale": 1.15 }, "antenna-left": { "rotate": 12 }, "antenna-right": { "rotate": -12 } },
    "startled":      { "book-closed": { "visible": true }, "eyes": { "scale": 1.25 }, "antenna-left": { "rotate": 28 }, "antenna-right": { "rotate": -28 },
                       "head": { "translate": [0, -2] }, "wing-left": { "rotate": 14 }, "wing-right": { "rotate": -14 }, "thorax": { "translate": [0, -1] } },
    "cling":         { "book-closed": { "visible": true }, "wing-left": { "rotate": -10, "scale": 1.05 }, "wing-right": { "rotate": 16, "scale": 1.05 },
                       "head": { "rotate": -8 }, "antenna-left": { "rotate": -15 }, "antenna-right": { "rotate": -25 }, "eyes": { "scale": 1.15 } },
    "smooth-down":   { "book-closed": { "visible": true }, "wing-left": { "rotate": -3 }, "wing-right": { "rotate": 5 }, "head": { "rotate": -3 } },
    "disapprove":    { "book-closed": { "visible": true }, "half-lids": { "visible": true }, "antenna-left": { "rotate": -55 }, "antenna-right": { "rotate": 55 },
                       "head": { "rotate": -5 } },
    "glance":        { "book-open": { "visible": true }, "head": { "rotate": 6 } },
    "nod":           { "book-open": { "visible": true }, "head": { "translate": [0, 2.2], "rotate": 4 } },
    "magnifier":     { "book-closed": { "visible": true }, "magnifier": { "visible": true }, "head": { "rotate": -4 } },
    "wave":          { "book-closed": { "visible": true }, "arm-wave": { "visible": true }, "head": { "rotate": -6 } },
    "close-book":    { "book-closed": { "visible": true }, "head": { "rotate": 2 }, "lids": { "visible": false } },
    "take-off":      { "wing-left": { "rotate": 38 }, "wing-right": { "rotate": -38 }, "head": { "translate": [0, -3] }, "thorax": { "translate": [0, -2] },
                       "tail": { "translate": [0, -3], "rotate": 0 }, "antenna-left": { "rotate": 10 }, "antenna-right": { "rotate": -10 } },
    "fly":           { "wing-left": { "rotate": 55, "scale": 0.9 }, "wing-right": { "rotate": -55, "scale": 0.9 }, "head": { "translate": [0, -4] },
                       "thorax": { "translate": [0, -3] }, "tail": { "translate": [0, -5] }, "antenna-left": { "rotate": 18 }, "antenna-right": { "rotate": -18 } },
    "fly-2":         { "wing-left": { "rotate": 22, "scale": 1.05 }, "wing-right": { "rotate": -22, "scale": 1.05 }, "head": { "translate": [0, -4] },
                       "thorax": { "translate": [0, -3] }, "tail": { "translate": [0, -5] }, "antenna-left": { "rotate": 12 }, "antenna-right": { "rotate": -12 } },
    "land":          { "wing-left": { "rotate": 18 }, "wing-right": { "rotate": -18 }, "head": { "translate": [0, -1] }, "thorax": { "translate": [0, -1] },
                       "tail": { "translate": [0, -1] }, "antenna-left": { "rotate": 6 }, "antenna-right": { "rotate": -6 } }
  }
}
